# Google AI Studio 에서 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 운세 텍스트 모델 (gemini-1.5-flash 는 서비스 종료됨 → 2.5-flash 권장, 무료 티어 있음)
TEXT_MODEL=gemini-2.5-flash

# 그림은 AI 로 만들지 않고 public/img/ 에 미리 넣어 둔 것을 쓴다 (scenes/PROMPTS.md 참고)

# 서버
PORT=3000
# Nginx 뒤에서만 받으려면 127.0.0.1 (외부에서 3000 직접 접속 차단)
HOST=127.0.0.1
# 실제 클라이언트 IP 를 X-Forwarded-For 에서 읽을 프록시 (Nginx 가 같은 서버면 loopback)
TRUST_PROXY=loopback

# 무료 한도 보호
RATE_LIMIT_PER_MIN=6
# 하루 Gemini 호출 상한 (넘으면 내장 문구로 응답)
DAILY_TEXT_LIMIT=200
# 공유 링크용으로 data/results.json 에 보관할 최근 결과 수 (넘으면 오래된 것부터 지움)
KEEP_RESULTS=1000

# 카카오톡 공유 (선택). https://developers.kakao.com 에서 앱을 만들고 JavaScript 키를 넣는다.
# 앱 설정에 사이트 도메인(https://malgeumi.161.33.130.92.sslip.io)을 등록해야 동작한다.
KAKAO_JS_KEY=
# SDK 주소와 integrity 값은 카카오 개발자 사이트의 JavaScript SDK 다운로드 페이지에서 복사한다 (비우면 기본값)
KAKAO_SDK_URL=
KAKAO_SDK_INTEGRITY=
