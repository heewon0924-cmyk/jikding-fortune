# Google AI Studio 에서 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 운세 텍스트 모델 (gemini-1.5-flash 는 서비스 종료됨 → 2.5-flash 권장, 무료 티어 있음)
TEXT_MODEL=gemini-2.5-flash

# 이미지 모델
#  - imagen-3.0-generate-002 / imagen-4.0-generate-001 : Imagen (유료 결제 계정 필요)
#  - gemini-2.5-flash-image                           : Gemini 이미지 모델 (generateContent 방식)
# 무료 키에서 이미지 생성이 거절되면 자동으로 내장 SVG 캐릭터를 대신 보여줍니다.
IMAGE_MODEL=imagen-3.0-generate-002
# 완전 무료로만 쓰려면 false (텍스트만 AI, 그림은 내장 캐릭터)
IMAGE_ENABLED=true

# 서버
PORT=3000
# Nginx 뒤에서만 받으려면 127.0.0.1 (외부에서 3000 직접 접속 차단)
HOST=127.0.0.1
# 실제 클라이언트 IP 를 X-Forwarded-For 에서 읽을 프록시 (Nginx 가 같은 서버면 loopback)
TRUST_PROXY=loopback

# 무료 한도 보호
RATE_LIMIT_PER_MIN=6
DAILY_TEXT_LIMIT=200
DAILY_IMAGE_LIMIT=30
# 공유 링크용으로 메모리에 보관할 최근 결과 수 (재시작 시 초기화)
KEEP_RESULTS=100
